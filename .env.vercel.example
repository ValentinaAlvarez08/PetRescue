# Variables para Vercel (Settings → Environment Variables → pega este contenido).
# Completa los valores vacíos. NO subas este archivo con contraseñas reales.

APP_NAME=PetRescue
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://tu-proyecto.vercel.app
APP_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Base de datos MySQL en la nube
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Si el proveedor exige SSL (Aiven, TiDB), deja esta ruta: es el certificado del sistema en Vercel.
MYSQL_ATTR_SSL_CA=/etc/pki/tls/certs/ca-bundle.crt

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
